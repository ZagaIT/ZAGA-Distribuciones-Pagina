---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('seo.404.title')} noindex={true}>
  <section class="flex-grow flex flex-col items-center justify-center text-center px-6 py-32 min-h-[70vh]">
    <p class="ind-figure text-8xl text-zaga-amber mb-6">404</p>
    <h1 class="ind-display text-4xl lg:text-5xl text-zaga-navy mb-4">{t('notfound.title')}</h1>
    <p class="text-xl text-zaga-ink-muted mb-10 max-w-xl">{t('notfound.desc')}</p>
    <a href="/" class="ind-btn ind-btn-solid">
      {t('notfound.btn')}
    </a>
  </section>
</Layout>
