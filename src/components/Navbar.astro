---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { Image } from 'astro:assets';
import logoZaga from '../assets/logoZaga.png';
import PresetSwitcher from './PresetSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = lang === 'en' ? '/en' : '';

// Rutas con barra final para evitar redirecciones 307 (SEO)
const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const currentPath = withSlash(Astro.url.pathname.replace(/^\/en(\/|$)/, '/') || '/');
const pathEs = currentPath;
const pathEn = currentPath === '/' ? '/en/' : `/en${currentPath}`;
---

<nav class="sticky top-0 z-50 bg-zaga-navy/85 backdrop-blur-md border-b border-white/10 transition-all duration-300 text-white p-4">
  <div class="container mx-auto flex justify-between items-center">
    
    <!-- Header Logo "Insignia" -->
    <a href={`${basePath}/`} class="flex items-center gap-3 md:gap-4 group">
      <div class="bg-white p-2 md:p-2.5 rounded-2xl shadow-xl inline-block group-hover:-translate-y-1 transition-transform duration-300">
        <Image alt="ZAGA Distribuciones Logo" class="w-10 h-10 md:w-12 md:h-12 object-contain" src={logoZaga}/>
      </div>
      <span class="brand-word text-2xl md:text-3xl font-bold tracking-widest uppercase group-hover:text-zaga-cyan transition-colors mt-2 md:mt-0">ZAGA</span>
    </a>

    <!-- Hamburguesa Mobile -->
    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden flex items-center text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-zaga-cyan p-2"
      aria-label={t('nav.menu.open')}
      aria-expanded="false"
      aria-controls="nav-menu"
      data-label-open={t('nav.menu.open')}
      data-label-close={t('nav.menu.close')}
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Navegación -->
    <div id="nav-menu" class="hidden lg:flex flex-col lg:flex-row absolute lg:static top-full left-0 w-full lg:w-auto bg-zaga-navy/95 lg:bg-transparent backdrop-blur-lg lg:backdrop-blur-none p-6 lg:p-0 gap-6 lg:gap-8 shadow-2xl lg:shadow-none border-t border-white/10 lg:border-none transition-all">
      <a href={`${basePath}/nosotros/`} class="ind-data text-sm lg:text-xs uppercase tracking-[0.12em] hover:text-zaga-amber transition-colors flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-zaga-cyan">{t('nav.about')}</a>
      <a href={`${basePath}/servicios/`} class="ind-data text-sm lg:text-xs uppercase tracking-[0.12em] hover:text-zaga-amber transition-colors flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-zaga-cyan">{t('nav.services')}</a>
      <a href={`${basePath}/marcas/`} class="ind-data text-sm lg:text-xs uppercase tracking-[0.12em] hover:text-zaga-amber transition-colors flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-zaga-cyan">{t('nav.brands')}</a>
      <a href={`${basePath}/contacto/`} class="ind-btn ind-btn-amber lg:ml-2 !py-3 lg:!py-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">{t('nav.contact')}</a>

      <!-- Selector de Presets de Estilo (temporal, para revisión del cliente) -->
      <PresetSwitcher />

      <!-- Selector de Idiomas -->
      <div class="relative pt-4 lg:pt-0 border-t border-white/10 lg:border-none lg:ml-4 flex items-center">
        <button
          id="lang-menu-btn"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          class="ind-data flex items-center justify-between w-full lg:w-auto gap-3 bg-white/10 border border-white/20 py-3 px-5 lg:py-2.5 lg:px-4 text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-zaga-cyan hover:border-zaga-cyan hover:bg-white/20 transition-all"
        >
          <span class="font-medium tracking-wide">{lang === 'es' ? '🇲🇽 ES' : '🇺🇸 EN'}</span>
          <svg class="w-4 h-4 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        
        <div id="lang-dropdown" class="absolute hidden top-full mt-3 w-full lg:w-44 bg-white text-zaga-navy overflow-hidden z-20 border border-zaga-line flex-col right-0 transform origin-top transition-all">
          <a href={pathEs} class="ind-data text-sm px-5 py-3.5 hover:bg-zaga-surface flex items-center gap-3 transition-colors border-b border-zaga-line">
            <span class="text-xl">🇲🇽</span> Español
          </a>
          <a href={pathEn} class="ind-data text-sm px-5 py-3.5 hover:bg-zaga-surface flex items-center gap-3 transition-colors">
            <span class="text-xl">🇺🇸</span> English
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  const toggleBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('nav-menu');
  const langBtn = document.getElementById('lang-menu-btn');
  const langDropdown = document.getElementById('lang-dropdown');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      // El menú está abierto cuando deja de tener la clase `hidden`.
      const abierto = menu.classList.toggle('hidden') === false;
      menu.classList.toggle('flex', abierto);
      toggleBtn.setAttribute('aria-expanded', String(abierto));
      const etiqueta = abierto
        ? toggleBtn.dataset.labelClose
        : toggleBtn.dataset.labelOpen;
      if (etiqueta) toggleBtn.setAttribute('aria-label', etiqueta);
    });
  }

  if (langBtn && langDropdown) {
    const cerrarLang = () => {
      langDropdown.classList.add('hidden');
      langDropdown.classList.remove('flex');
      langBtn.setAttribute('aria-expanded', 'false');
    };

    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const abierto = langDropdown.classList.toggle('hidden') === false;
      langDropdown.classList.toggle('flex', abierto);
      langBtn.setAttribute('aria-expanded', String(abierto));
    });

    document.addEventListener('click', () => {
      if (!langDropdown.classList.contains('hidden')) cerrarLang();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !langDropdown.classList.contains('hidden')) {
        cerrarLang();
        langBtn.focus();
      }
    });
  }
</script>
