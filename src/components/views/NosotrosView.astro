---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import almacenZaga from '../../assets/almacen.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Misión / Visión / Valores. Cada bloque lleva su filete de acento propio.
const pilares = [
  {
    key: 'mission',
    num: '01',
    rule: 'ind-card-rule',
    icon: 'M12 3l8 3v6c0 4.4-3.4 8.2-8 9-4.6-.8-8-4.6-8-9V6l8-3zm-2.2 9l1.7 1.7 3.4-3.4',
  },
  {
    key: 'vision',
    num: '02',
    rule: 'ind-card-rule-amber',
    icon: 'M2.5 12C3.8 7.9 7.5 5 12 5s8.2 2.9 9.5 7c-1.3 4.1-5 7-9.5 7s-8.2-2.9-9.5-7zm9.5 3a3 3 0 100-6 3 3 0 000 6z',
  },
  {
    key: 'values',
    num: '03',
    rule: 'ind-card-rule-navy',
    icon: 'M12 4v16M4 8h16M6 4h12v16H6z',
  },
] as const;

const listItems = ['about.list.one', 'about.list.two', 'about.list.three'] as const;
---

<Layout lang={lang} title={t('seo.about.title')} description={t('seo.about.desc')}>

  <!-- Encabezado -->
  <section class="bg-zaga-navy pt-28 pb-20 lg:pt-32 lg:pb-24 px-6 relative overflow-hidden">
    <div class="ind-grid-lines" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto animate-on-scroll">
      <p class="ind-eyebrow mb-6">{t('company.name')}</p>
      <h1 class="display-title ind-display text-5xl lg:text-7xl text-white">
        {t('nav.about')}
      </h1>
      <div class="w-24 h-[3px] bg-zaga-amber mt-6" aria-hidden="true"></div>
    </div>
  </section>

  <section class="container mx-auto px-6 py-16 lg:py-24 flex-grow">

    <!-- Misión, Visión, Valores -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-zaga-line mb-24 max-w-7xl mx-auto">
      {pilares.map((p, i) => (
        <article
          class={`ind-card ${p.rule} p-8 lg:p-10 animate-on-scroll`}
          style={`transition-delay: ${i * 100}ms`}
        >
          <div class="flex items-start justify-between mb-6">
            <div class="w-12 h-12 icon-chip flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={p.icon} />
              </svg>
            </div>
            <span class="ind-figure text-2xl text-zaga-line">{p.num}</span>
          </div>

          <h2 class="ind-display text-2xl lg:text-3xl text-zaga-navy mb-4">
            {t(`about.${p.key}.title` as any)}
          </h2>
          <!-- Sin text-justify: en móvil produce ríos de espacio ilegibles. -->
          <p class="text-zaga-ink-muted text-base leading-relaxed">
            {t(`about.${p.key}.text` as any)}
          </p>
        </article>
      ))}
    </div>

    <!-- Infraestructura / Experiencia -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center max-w-7xl mx-auto">

      <div class="space-y-8 animate-on-scroll">
        <div>
          <p class="ind-eyebrow mb-5">{t('about.experience.eyebrow')}</p>
          <h2 class="display-title ind-display text-4xl lg:text-5xl text-zaga-navy mb-6">
            {t('about.experience.title')}
          </h2>
          <p class="text-lg text-zaga-ink-muted leading-relaxed">
            {t('about.experience.desc')}
          </p>
        </div>

        <ul class="ind-specs grid-cols-1">
          {listItems.map((key, i) => (
            <li class="ind-spec flex items-start gap-5">
              <span class="ind-figure text-sm text-zaga-amber pt-1 flex-shrink-0">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-zaga-navy text-base lg:text-lg font-medium">
                {t(key)}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Imagen del almacén -->
      <div class="animate-on-scroll" style="transition-delay: 180ms;">
        <figure class="relative overflow-hidden border border-zaga-line aspect-[4/3] group">
          <Image
            alt={t('about.warehouse.alt')}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src={almacenZaga}
          />
          <figcaption
            class="ind-data absolute bottom-0 left-0 right-0 bg-zaga-navy/90 text-white text-[11px] uppercase tracking-[0.16em] px-5 py-3"
          >
            {t('about.warehouse.caption')}
          </figcaption>
        </figure>
      </div>

    </div>
  </section>
</Layout>
