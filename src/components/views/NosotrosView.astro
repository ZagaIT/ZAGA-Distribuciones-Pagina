---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import almacenZaga from '../../assets/almacen.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/*
 * Misión / Visión / Valores. Cada bloque lleva su propio icono; el acento
 * superior sale de la paleta activa en vez del gris fijo que traía el tercero.
 */
const pilares = [
  {
    titleKey: 'about.mission.title',
    textKey: 'about.mission.text',
    accent: 'var(--zaga-blue)',
    icon: 'M12 21a9 9 0 100-18 9 9 0 000 18zM12 15a3 3 0 100-6 3 3 0 000 6zM12 3v3M12 18v3M3 12h3M18 12h3',
  },
  {
    titleKey: 'about.vision.title',
    textKey: 'about.vision.text',
    accent: 'var(--zaga-cyan)',
    icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.5 12C3.7 7.9 7.5 5 12 5s8.3 2.9 9.5 7c-1.2 4.1-5 7-9.5 7s-8.3-2.9-9.5-7z',
  },
  {
    titleKey: 'about.values.title',
    textKey: 'about.values.text',
    accent: 'var(--zaga-navy)',
    icon: 'M12 21l-1.5-1.3C5.4 15.1 2 12.1 2 8.5 2 5.9 4 4 6.5 4c1.5 0 2.9.7 3.5 1.8h.1C11.6 4.7 13 4 14.5 4 17 4 19 5.9 19 8.5c0 3.6-3.4 6.6-8.5 11.2L12 21z',
  },
] as const;

const listItems = ['about.list.one', 'about.list.two', 'about.list.three'] as const;
---

<Layout lang={lang} title={t('seo.about.title')} description={t('seo.about.desc')}>
  <div class="flex-grow flex flex-col">

    <!-- Encabezado -->
    <section class="pt-16 pb-10 lg:pt-20 lg:pb-12 px-6 bg-white">
      <div class="max-w-6xl mx-auto animate-on-scroll">
        <h1 class="display-title rule-accent text-4xl lg:text-5xl font-bold text-zaga-navy tracking-tight">
          {t('nav.about')}
        </h1>
      </div>
    </section>

    <!-- Misión, Visión, Valores -->
    <section class="pb-16 lg:pb-20 pt-10 lg:pt-12 px-6 bg-zaga-surface">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">
        {pilares.map((p, i) => (
          <article
            class="card card-hover-raise p-8 lg:p-9 relative overflow-hidden animate-on-scroll"
            style={`transition-delay: ${i * 100}ms`}
          >
            <!-- Acento superior: sale de la paleta, no de un gris fijo -->
            <span
              class="absolute inset-x-0 top-0 h-1"
              style={`background:${p.accent}`}
              aria-hidden="true"
            ></span>

            <div class="w-12 h-12 rounded-ui icon-chip flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d={p.icon}></path>
              </svg>
            </div>

            <h2 class="text-2xl font-bold text-zaga-navy mb-4">{t(p.titleKey)}</h2>
            <!-- Sin text-justify: en móvil abría ríos entre palabras -->
            <p class="text-zaga-ink-muted leading-relaxed">{t(p.textKey)}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Experiencia + imagen del almacén -->
    <section class="section px-6 bg-white">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <div class="animate-on-scroll">
          <h2 class="display-title rule-accent text-3xl lg:text-4xl font-bold text-zaga-navy tracking-tight">
            {t('about.experience.title')}
          </h2>
          <p class="text-lg text-zaga-ink-muted leading-relaxed mt-7">
            {t('about.experience.desc')}
          </p>

          <ul class="space-y-5 mt-9">
            {listItems.map((key) => (
              <li class="flex items-start gap-4">
                <span class="flex-shrink-0 w-7 h-7 rounded-full icon-chip flex items-center justify-center mt-0.5">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </span>
                <span class="text-zaga-navy text-lg font-medium">{t(key)}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="animate-on-scroll" style="transition-delay: 150ms;">
          <figure class="rounded-card overflow-hidden shadow-raise border border-zaga-line group relative">
            <Image
              alt={t('about.facility.caption')}
              class="w-full aspect-[4/3] object-cover group-hover:scale-105 transition-transform duration-700"
              src={almacenZaga}
            />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-zaga-navy/85 to-transparent text-white text-sm font-medium px-5 pt-10 pb-4">
              {t('about.facility.caption')}
            </figcaption>
          </figure>
        </div>

      </div>
    </section>

  </div>
</Layout>
