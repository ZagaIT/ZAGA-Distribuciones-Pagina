---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/*
 * Un icono por categoría. Antes las siete tarjetas repetían el mismo rayo,
 * así que el icono no aportaba información: sólo decoraba. Cada trazo de
 * abajo describe lo que la categoría realmente vende.
 *
 * `linkCat` apunta al filtro equivalente del catálogo de marcas cuando existe
 * (la página de Marcas lee las categorías del hash: /marcas/#control).
 */
const serviceCategories = [
  {
    key: 'cat1',
    // Suministro e instalación: caja/paquete con flecha de entrega
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
    linkCat: null,
  },
  {
    key: 'cat2',
    // Conductores: cable trenzado saliendo de su cubierta
    icon: 'M3 7c3 0 3 10 6 10s3-10 6-10 3 10 6 10M3 12h4M17 12h4',
    linkCat: 'conductores',
  },
  {
    key: 'cat3',
    // Tubería conduit: tramo de tubo visto de lado, con sus bridas
    icon: 'M2 9h20v6H2zM7 9v6M17 9v6M5 7v10M19 7v10',
    linkCat: 'tuberia',
  },
  {
    key: 'cat4',
    // Control y distribución: tablero con interruptores
    icon: 'M4 4h16v16H4zM9 8v3M15 8v3M9 14h.01M15 14h.01M9 17h6',
    linkCat: 'control',
  },
  {
    key: 'cat5',
    // Iluminación: lámpara / bombilla
    icon: 'M9 18h6M10 21h4M12 3a6 6 0 00-4 10.5c.6.6 1 1.3 1 2.1V16h6v-.4c0-.8.4-1.5 1-2.1A6 6 0 0012 3z',
    linkCat: 'iluminacion',
  },
  {
    key: 'cat6',
    // Protección: escudo con descarga
    icon: 'M12 3l8 3v6c0 4.5-3.2 7.9-8 9-4.8-1.1-8-4.5-8-9V6l8-3zM12.5 8l-2.5 4h2l-.5 3.5 3-4.5h-2z',
    linkCat: 'proteccion',
  },
  {
    key: 'cat7',
    // Ferretería y acabados: llave inglesa
    icon: 'M14.7 6.3a4 4 0 105.1 5.1l-2.6-2.6 1.4-1.4-2.5-2.5-1.4 1.4zM13.3 9.1L4.6 17.8a2 2 0 102.8 2.8l8.7-8.7',
    linkCat: 'ferreteria',
  },
] as const;

const basePath = lang === 'en' ? '/en' : '';
---

<Layout lang={lang} title={t('seo.services.title')} description={t('seo.services.desc')}>
  <div class="flex-grow flex flex-col">

    <!-- Encabezado -->
    <section class="bg-zaga-navy pt-28 pb-20 lg:pt-32 lg:pb-24 px-6 relative overflow-hidden">
      <div class="absolute inset-0 z-0 opacity-[0.05]" style="background-image: radial-gradient(var(--color-zaga-cyan) 2px, transparent 2px); background-size: 30px 30px;"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-zaga-blue rounded-full filter blur-[150px] opacity-20 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto animate-on-scroll">
        <h1 class="display-title rule-accent text-4xl lg:text-6xl font-bold text-white tracking-tight">
          {t('services.title')}
        </h1>
        <p class="text-lg lg:text-xl text-blue-50/90 mt-7 max-w-2xl leading-relaxed">
          {t('services.subtitle')}
        </p>
      </div>
    </section>

    <!--
      Catálogo. El gesto aquí NO es el levantamiento de la home: la tarjeta se
      queda en su sitio y se enciende (borde inferior de acento + superficie
      teñida). Siete tarjetas saltando a la vez se sentía inquieto.
    -->
    <section class="section px-6 bg-zaga-surface flex-grow">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          {serviceCategories.map((cat, index) => {
            const Tag = cat.linkCat ? 'a' : 'div';
            const attrs = cat.linkCat
              ? { href: `${basePath}/marcas/#${cat.linkCat}` }
              : {};
            return (
              <Tag
                {...attrs}
                class="card card-hover-glow group animate-on-scroll p-8 lg:p-9 flex flex-col no-underline text-inherit"
                style={`transition-delay: ${index * 70}ms`}
              >
                <div class="w-16 h-16 rounded-card icon-chip flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
                  <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={cat.icon}></path>
                  </svg>
                </div>

                <h2 class="card-title text-xl lg:text-2xl mb-3 leading-tight">
                  {t(`services.${cat.key}.title` as any)}
                </h2>
                <p class="text-zaga-ink-muted leading-relaxed flex-grow">
                  {t(`services.${cat.key}.desc` as any)}
                </p>

                {cat.linkCat && (
                  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-zaga-blue">
                    {t('services.see.brands')}
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </span>
                )}
              </Tag>
            );
          })}

        </div>
      </div>
    </section>

  </div>
</Layout>
