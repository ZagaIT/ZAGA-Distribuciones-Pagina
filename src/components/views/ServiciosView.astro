---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/**
 * Las 7 categorías de servicio. Cada una lleva su propio icono: antes se
 * repetía el mismo rayo en las 7, lo que las volvía indistinguibles de un
 * vistazo. Los trazos son de línea (stroke) para mantener el aire técnico.
 */
const serviceCategories = [
  {
    id: 'cat1',
    // Suministro e Instalación — caja / entrega
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    id: 'cat2',
    // Conductores Eléctricos — cable / onda conductora
    icon: 'M4 8c2.5 0 2.5 8 5 8s2.5-8 5-8 2.5 8 5 8M3 4h18M3 20h18',
  },
  {
    id: 'cat3',
    // Tubería Conduit — tubo con uniones
    icon: 'M3 9h4m0 0v6m0-6a2 2 0 012-2h6a2 2 0 012 2m0 0h4m-4 0v6m0 0h4m-4 0a2 2 0 01-2 2H9a2 2 0 01-2-2m0 0H3',
  },
  {
    id: 'cat4',
    // Control y Distribución — tablero / interruptores
    icon: 'M4 4h16v16H4zM9 8v8m6-8v8M4 12h16',
  },
  {
    id: 'cat5',
    // Iluminación Profesional — luminaria
    icon: 'M9 18h6m-5 3h4m-6-9a5 5 0 1110 0c0 1.8-1 2.6-1.7 3.4-.5.6-.8 1-.8 1.6H10.5c0-.6-.3-1-.8-1.6C9 14.6 8 13.8 8 12z',
  },
  {
    id: 'cat6',
    // Sistemas de Protección — escudo / pararrayos
    icon: 'M12 3l8 3v6c0 4.4-3.4 8.2-8 9-4.6-.8-8-4.6-8-9V6l8-3z',
  },
  {
    id: 'cat7',
    // Ferretería y Acabados — llave / herramienta
    icon: 'M14.7 6.3a4 4 0 01-5 5L5 16v3h3l4.7-4.7a4 4 0 015-5V6.3l-2 2-1.6-1.6 2-2h-1.4z',
  },
] as const;
---

<Layout lang={lang} title={t('seo.services.title')} description={t('seo.services.desc')}>
  <div class="flex-grow flex flex-col">

    <!-- Hero Header de Servicios -->
    <section class="bg-zaga-navy pt-28 pb-20 lg:pt-32 lg:pb-24 px-6 relative overflow-hidden">
      <div class="ind-grid-lines" aria-hidden="true"></div>

      <div class="relative z-10 max-w-7xl mx-auto animate-on-scroll">
        <p class="ind-eyebrow mb-6">{t('nav.services')}</p>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
          <div class="lg:col-span-7">
            <h1 class="display-title ind-display text-5xl lg:text-7xl text-white">
              {t('services.title')}
            </h1>
            <div class="w-24 h-[3px] bg-zaga-amber mt-6" aria-hidden="true"></div>
          </div>

          <div class="lg:col-span-5">
            <p class="text-base md:text-lg text-white/70 leading-relaxed">
              {t('services.subtitle')}
            </p>
            <p class="ind-data text-[11px] uppercase tracking-[0.16em] text-white/50 mt-5">
              <span class="ind-figure text-zaga-amber text-base">{serviceCategories.length}</span>
              <span class="ml-2">{t('services.count.label')}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Catálogo: rejilla de fichas técnicas unidas por filetes -->
    <section class="py-20 lg:py-24 px-6 bg-zaga-surface flex-grow">
      <div class="max-w-7xl mx-auto">
        <div class="ind-specs grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {serviceCategories.map((cat, index) => (
            <article
              class="ind-spec bg-white group flex flex-col p-8 lg:p-10 animate-on-scroll transition-colors duration-300 hover:bg-zaga-surface"
              style={`transition-delay: ${index * 80}ms`}
            >
              <div class="flex items-start justify-between mb-8">
                <div class="w-14 h-14 icon-chip flex items-center justify-center">
                  <svg
                    class="w-7 h-7"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d={cat.icon}
                    />
                  </svg>
                </div>
                <span class="ind-figure text-2xl text-zaga-line">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>

              <h2 class="card-title ind-display text-2xl md:text-3xl mb-4 leading-tight">
                {t(`services.${cat.id}.title` as any)}
              </h2>

              <p class="text-zaga-ink-muted leading-relaxed flex-grow">
                {t(`services.${cat.id}.desc` as any)}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

  </div>
</Layout>
