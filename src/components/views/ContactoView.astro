---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { SITE } from '../../config/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Ubicación: se arma a partir de los datos ya centralizados en site.ts
const { streetAddress, locality, region, postalCode } = SITE.address;
const fullAddress = `${streetAddress}, ${locality}, ${region}, C.P. ${postalCode}`;

// Si hay coordenadas usamos el punto exacto; si no, caemos a la dirección escrita.
const hasGeo = SITE.geo.latitude != null && SITE.geo.longitude != null;
const mapQuery = hasGeo
  ? `${SITE.geo.latitude},${SITE.geo.longitude}`
  : fullAddress;

// Embed sin API key y enlace para abrir la app de mapas del usuario.
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed`;
const mapLinkUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;

// Teléfonos y correos salen de site.ts: antes estaban duplicados a mano aquí.
const formatPhone = (plain: string) => {
  const d = plain.replace(/^\+52/, '');
  return `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6, 8)}-${d.slice(8)}`;
};

const telefonos = [
  { plain: SITE.phones.primaryPlain, whatsapp: true },
  { plain: SITE.phones.secondaryPlain, whatsapp: false },
];

const correos = [SITE.emails.primary, SITE.emails.secondary];

const waMessage = lang === 'en'
  ? 'Hello, I would like more information.'
  : 'Hola, me gustaría más información.';
---

<Layout lang={lang} title={t('seo.contact.title')} description={t('seo.contact.desc')}>

  <!-- Encabezado -->
  <section class="bg-zaga-navy pt-28 pb-20 lg:pt-32 lg:pb-24 px-6 relative overflow-hidden">
    <div class="ind-grid-lines" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto animate-on-scroll">
      <p class="ind-eyebrow mb-6">{t('contact.eyebrow')}</p>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <h1 class="display-title ind-display text-5xl lg:text-7xl text-white">
            {t('contact.title')}
          </h1>
          <div class="w-24 h-[3px] bg-zaga-amber mt-6" aria-hidden="true"></div>
        </div>
        <div class="lg:col-span-5">
          <p class="text-base md:text-lg text-white/70 leading-relaxed">
            {t('contact.subtitle')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-6 py-16 lg:py-24 flex-grow">

    <!-- Teléfonos + Correos -->
    <div class="ind-specs grid-cols-1 md:grid-cols-2 max-w-5xl mx-auto">

      <!-- Teléfonos -->
      <div class="ind-spec bg-white p-8 lg:p-10 animate-on-scroll">
        <div class="flex items-center gap-4 mb-7">
          <div class="w-12 h-12 icon-chip flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h2 class="ind-display text-2xl text-zaga-navy">{t('contact.call_us')}</h2>
        </div>

        <ul class="space-y-4">
          {telefonos.map((tel) => (
            <li class="flex items-center gap-3">
              <a
                href={`tel:${tel.plain}`}
                class="ind-data text-lg text-zaga-navy hover:text-zaga-blue transition-colors"
              >
                {formatPhone(tel.plain)}
              </a>
              {tel.whatsapp && (
                <a
                  href={`https://wa.me/${tel.plain.replace('+', '')}?text=${encodeURIComponent(waMessage)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="WhatsApp"
                  class="text-[#25d366] hover:opacity-75 transition-opacity"
                >
                  <svg class="w-5 h-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                    <path d="M16.004 2.667c-7.363 0-13.333 5.97-13.333 13.333 0 2.353.615 4.647 1.784 6.667L2.667 29.333l6.822-1.76a13.27 13.27 0 006.515 1.76h.006c7.362 0 13.333-5.97 13.333-13.333 0-3.56-1.387-6.907-3.906-9.427a13.24 13.24 0 00-9.433-3.906zm0 24.4h-.005a11.02 11.02 0 01-5.62-1.539l-.403-.24-4.05 1.046 1.082-3.948-.263-.405a11.02 11.02 0 01-1.7-5.881c0-6.101 4.965-11.066 11.064-11.066a11 11 0 017.826 3.243 10.98 10.98 0 013.238 7.83c0 6.101-4.966 11.06-11.069 11.06zm6.066-8.288c-.332-.166-1.965-.97-2.27-1.081-.305-.111-.527-.166-.749.166s-.86 1.081-1.054 1.303-.388.25-.72.083c-.332-.166-1.402-.517-2.67-1.649-.987-.881-1.654-1.968-1.848-2.3s-.021-.512.145-.677c.149-.148.332-.388.498-.582.166-.194.221-.333.332-.555.111-.222.055-.416-.028-.582-.083-.166-.749-1.804-1.026-2.472-.27-.65-.545-.562-.749-.572l-.638-.011c-.222 0-.582.083-.887.416s-1.165 1.138-1.165 2.777 1.192 3.222 1.358 3.444c.166.222 2.347 3.584 5.687 5.026.794.343 1.414.548 1.897.702.797.254 1.522.218 2.096.132.64-.096 1.965-.803 2.242-1.579.277-.777.277-1.443.194-1.58-.083-.138-.305-.222-.638-.388z" />
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Correos -->
      <div class="ind-spec bg-white p-8 lg:p-10 animate-on-scroll" style="transition-delay: 120ms;">
        <div class="flex items-center gap-4 mb-7">
          <div class="w-12 h-12 icon-chip flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="ind-display text-2xl text-zaga-navy">{t('contact.email_us')}</h2>
        </div>

        <ul class="space-y-4">
          {correos.map((mail) => (
            <li>
              <a
                href={`mailto:${mail}`}
                class="ind-data text-sm lg:text-base text-zaga-navy hover:text-zaga-blue transition-colors break-all"
              >
                {mail}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Panel de Ubicación: dirección + mapa (conservado, re-estilizado) -->
    <div class="max-w-5xl mx-auto mt-12 animate-on-scroll" style="transition-delay: 240ms;">
      <div class="border border-zaga-line ind-card-rule-amber overflow-hidden bg-white">
        <div class="grid grid-cols-1 md:grid-cols-2">

          <!-- Dirección en texto -->
          <div class="p-8 lg:p-10 flex flex-col justify-center">
            <p class="ind-eyebrow mb-5">{t('contact.visit_us')}</p>

            <address class="not-italic mb-5">
              <span class="ind-display block text-2xl lg:text-3xl text-zaga-navy leading-tight mb-3">
                {streetAddress}
              </span>
              <span class="ind-data block text-sm text-zaga-ink-muted leading-relaxed">
                {locality}, {region}<br />
                C.P. {postalCode}
              </span>
            </address>

            <p class="text-zaga-ink-muted text-sm leading-relaxed mb-8">
              {t('contact.location_note')}
            </p>

            <a
              href={mapLinkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="ind-btn ind-btn-amber self-start"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              {t('contact.open_in_maps')}
            </a>
          </div>

          <!-- Widget de Google Maps -->
          <div class="min-h-[320px] md:min-h-full bg-zaga-surface border-t md:border-t-0 md:border-l border-zaga-line">
            <iframe
              src={mapEmbedUrl}
              title={t('contact.map_title')}
              class="w-full h-full min-h-[320px] border-0 block"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>

        </div>
      </div>
    </div>

  </section>
</Layout>
