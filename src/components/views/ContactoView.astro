---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { SITE } from '../../config/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Ubicación: se arma a partir de los datos ya centralizados en site.ts
const { streetAddress, locality, region, postalCode } = SITE.address;
const fullAddress = `${streetAddress}, ${locality}, ${region}, C.P. ${postalCode}`;

// Si hay coordenadas usamos el punto exacto; si no, caemos a la dirección escrita.
const hasGeo = SITE.geo.latitude != null && SITE.geo.longitude != null;
const mapQuery = hasGeo
  ? `${SITE.geo.latitude},${SITE.geo.longitude}`
  : fullAddress;

// Embed sin API key y enlace para abrir la app de mapas del usuario.
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed`;
const mapLinkUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;

// Teléfonos y correos salen de site.ts; el formato visible se arma aquí.
const telefonos = [
  { plain: SITE.phones.primaryPlain, display: '(833) 107-32-78', whatsapp: true },
  { plain: SITE.phones.secondaryPlain, display: '(833) 362-92-38', whatsapp: false },
];
const correos = [SITE.emails.primary, SITE.emails.secondary];

const waHref = `${SITE.whatsapp}?text=${encodeURIComponent(
  lang === 'en' ? 'Hello, I would like more information.' : 'Hola, me gustaría más información.'
)}`;
---

<Layout lang={lang} title={t('seo.contact.title')} description={t('seo.contact.desc')}>
  <div class="flex-grow flex flex-col">

    <!-- Encabezado -->
    <section class="pt-16 pb-10 lg:pt-20 lg:pb-12 px-6 bg-white">
      <div class="max-w-6xl mx-auto animate-on-scroll">
        <h1 class="display-title rule-accent text-4xl lg:text-5xl font-bold text-zaga-navy tracking-tight">
          {t('contact.title')}
        </h1>
        <p class="text-lg lg:text-xl text-zaga-ink-muted mt-7 max-w-2xl leading-relaxed">
          {t('contact.subtitle')}
        </p>
      </div>
    </section>

    <section class="pb-16 lg:pb-20 pt-10 lg:pt-12 px-6 bg-zaga-surface flex-grow">
      <div class="max-w-6xl mx-auto grid gap-6">

        <!-- Teléfonos y correos -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <article class="card card-hover-raise p-8 lg:p-9 animate-on-scroll">
            <div class="w-12 h-12 icon-chip rounded-ui flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-zaga-navy mb-5">{t('contact.call_us')}</h2>
            <ul class="space-y-3">
              {telefonos.map((tel) => (
                <li class="flex items-center gap-3">
                  <a
                    href={`tel:${tel.plain}`}
                    class="text-lg text-zaga-ink-muted hover:text-zaga-blue font-medium transition-colors"
                  >
                    {tel.display}
                  </a>
                  {tel.whatsapp && (
                    <a
                      href={waHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="WhatsApp"
                      class="text-[#25d366] hover:opacity-75 transition-opacity"
                    >
                      <svg class="w-5 h-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                        <path d="M16.004 2.667c-7.363 0-13.333 5.97-13.333 13.333 0 2.353.615 4.647 1.784 6.667L2.667 29.333l6.822-1.76a13.27 13.27 0 006.515 1.76h.006c7.362 0 13.333-5.97 13.333-13.333 0-3.56-1.387-6.907-3.906-9.427a13.24 13.24 0 00-9.433-3.906zm0 24.4h-.005a11.02 11.02 0 01-5.62-1.539l-.403-.24-4.05 1.046 1.082-3.948-.263-.405a11.02 11.02 0 01-1.7-5.881c0-6.101 4.965-11.066 11.064-11.066a11 11 0 017.826 3.243 10.98 10.98 0 013.238 7.83c0 6.101-4.966 11.06-11.069 11.06zm6.066-8.288c-.332-.166-1.965-.97-2.27-1.081-.305-.111-.527-.166-.749.166s-.86 1.081-1.054 1.303-.388.25-.72.083c-.332-.166-1.402-.517-2.67-1.649-.987-.881-1.654-1.968-1.848-2.3s-.021-.512.145-.677c.149-.148.332-.388.498-.582.166-.194.221-.333.332-.555.111-.222.055-.416-.028-.582-.083-.166-.749-1.804-1.026-2.472-.27-.65-.545-.562-.749-.572l-.638-.011c-.222 0-.582.083-.887.416s-1.165 1.138-1.165 2.777 1.192 3.222 1.358 3.444c.166.222 2.347 3.584 5.687 5.026.794.343 1.414.548 1.897.702.797.254 1.522.218 2.096.132.64-.096 1.965-.803 2.242-1.579.277-.777.277-1.443.194-1.58-.083-.138-.305-.222-.638-.388z"/>
                      </svg>
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </article>

          <article class="card card-hover-raise p-8 lg:p-9 animate-on-scroll" style="transition-delay: 100ms;">
            <div class="w-12 h-12 icon-chip rounded-ui flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-zaga-navy mb-5">{t('contact.email_us')}</h2>
            <ul class="space-y-3">
              {correos.map((correo) => (
                <li>
                  <a
                    href={`mailto:${correo}`}
                    class="text-zaga-ink-muted hover:text-zaga-blue font-medium transition-colors break-all"
                  >
                    {correo}
                  </a>
                </li>
              ))}
            </ul>
          </article>

        </div>

        <!-- Panel de ubicación: dirección + mapa. Se conserva; sólo se re-estiliza -->
        <article class="card overflow-hidden animate-on-scroll" style="transition-delay: 200ms;">
          <div class="grid grid-cols-1 md:grid-cols-2">

            <div class="p-8 lg:p-10 flex flex-col justify-center">
              <div class="w-12 h-12 icon-chip rounded-ui flex items-center justify-center mb-6">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <h2 class="text-xl font-bold text-zaga-navy mb-4">{t('contact.visit_us')}</h2>
              <address class="not-italic text-lg text-zaga-ink-muted font-medium leading-relaxed mb-4">
                {streetAddress}<br />
                {locality}, {region}<br />
                C.P. {postalCode}
              </address>
              <p class="text-zaga-ink-faint mb-7">{t('contact.location_note')}</p>
              <a
                href={mapLinkUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-btn self-start inline-flex items-center gap-2 bg-zaga-blue text-white font-bold px-6 py-3 rounded-ui hover:bg-zaga-navy transition-colors duration-300"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                </svg>
                {t('contact.open_in_maps')}
              </a>
            </div>

            <div class="min-h-[320px] md:min-h-full bg-zaga-surface">
              <iframe
                src={mapEmbedUrl}
                title={t('contact.map_title')}
                class="w-full h-full min-h-[320px] border-0 block"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>

          </div>
        </article>

      </div>
    </section>

  </div>
</Layout>
