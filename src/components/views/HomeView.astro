---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logoZaga from '../../assets/logoZaga.png';
import { marcas, categorias } from '../../data/marcas';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = lang === 'en' ? '/en' : '';

// Las cifras salen del catálogo real: si se agrega una marca, el número sube
// solo. Nada de métricas inventadas.
const totalMarcas = marcas.length;
const totalCategorias = categorias.length;

// Franja de logos: prueba social real con los archivos de src/assets/marcas.
const logos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/marcas/*.{png,jpg,jpeg,svg,webp}',
  { eager: true }
);

const normalize = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, '');

const findLogo = (brandName: string): ImageMetadata | null => {
  const target = normalize(brandName);
  for (const path in logos) {
    const filename = path.split('/').pop()?.split('.')[0] || '';
    if (normalize(filename) === target) return logos[path].default;
  }
  return null;
};

// Marcas de mayor reconocimiento, con logotipo real (no foto de producto).
const marcasDestacadas = [
  'SIEMENS',
  'ABB',
  'SQUARE D',
  'PHILIPS Lighting',
  'Allen-Bradley',
  'TRUPER',
  'LEVITON',
  'OMRON',
  'Crouse-Hinds by EATON',
  '3M',
  'Thomas & Betts',
  'tecnolite',
];

const logosDestacados = marcasDestacadas
  .map((name) => ({ name, img: findLogo(name) }))
  .filter((m): m is { name: string; img: ImageMetadata } => m.img !== null);

const features = [
  {
    key: 'quote',
    num: '01',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    key: 'delivery',
    num: '02',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    key: 'brands',
    num: '03',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
] as const;
---

<Layout lang={lang} title={t('seo.home.title')} description={t('seo.home.desc')}>
  <div class="flex-grow flex flex-col">

    <!-- ===== HERO — asimétrico: texto a la izquierda, ficha técnica a la derecha ===== -->
    <section class="relative overflow-hidden hero-gradient text-white">
      <!-- Rejilla vertical: textura de plano técnico -->
      <div class="ind-grid-lines" aria-hidden="true"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 pt-24 pb-16 lg:pt-32 lg:pb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-end">

          <!-- Columna principal (asimétrica: 7 de 12) -->
          <div class="lg:col-span-7 animate-on-scroll">
            <p class="ind-eyebrow mb-6">{t('home.eyebrow')}</p>

            <h1 class="ind-display text-5xl sm:text-6xl lg:text-8xl mb-6">
              <span class="block text-white">{t('company.name')}</span>
            </h1>

            <!-- Filete ámbar: marca el corte entre título y cuerpo -->
            <div class="w-24 h-[3px] bg-zaga-amber mb-8" aria-hidden="true"></div>

            <p class="text-base md:text-lg text-white/75 max-w-2xl leading-relaxed mb-10">
              {t('company.description')}
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <a href={`${basePath}/contacto/`} class="ind-btn ind-btn-amber">
                {t('company.cta.quote')}
              </a>
              <a href={`${basePath}/servicios/`} class="ind-btn ind-btn-outline">
                {t('company.cta.services')}
              </a>
            </div>
          </div>

          <!-- Ficha técnica: el logo y los datos duros, en mono -->
          <div class="lg:col-span-5 animate-on-scroll" style="transition-delay: 120ms;">
            <div class="border border-white/15 bg-white/[0.04] backdrop-blur-sm">

              <div class="flex items-center gap-5 p-6 border-b border-white/15">
                <div class="bg-white p-2.5 flex-shrink-0">
                  <Image
                    alt="ZAGA Distribuciones Logo"
                    class="w-14 h-14 object-contain"
                    src={logoZaga}
                  />
                </div>
                <div class="min-w-0">
                  <span class="ind-data block text-[10px] uppercase tracking-[0.16em] text-zaga-amber mb-1">
                    {t('home.stats.coverage')}
                  </span>
                  <span class="ind-data block text-sm text-white/80">
                    {t('home.hero.location')}
                  </span>
                </div>
              </div>

              <!-- Los números son protagonistas -->
              <dl class="grid grid-cols-2">
                <div class="p-6 border-r border-b border-white/15">
                  <dd class="ind-figure text-4xl lg:text-5xl text-zaga-amber">{totalMarcas}</dd>
                  <dt class="ind-data block text-[10px] uppercase tracking-[0.16em] text-white/55 mt-2">
                    {t('home.stats.brands')}
                  </dt>
                </div>
                <div class="p-6 border-b border-white/15">
                  <dd class="ind-figure text-4xl lg:text-5xl text-white">{totalCategorias}</dd>
                  <dt class="ind-data block text-[10px] uppercase tracking-[0.16em] text-white/55 mt-2">
                    {t('home.stats.categories')}
                  </dt>
                </div>
                <div class="col-span-2 p-6">
                  <dd class="ind-display text-2xl text-white">{t('home.stats.coverage.value')}</dd>
                  <dt class="ind-data block text-[10px] uppercase tracking-[0.16em] text-white/55 mt-2">
                    {t('home.stats.coverage')}
                  </dt>
                </div>
              </dl>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===== FRANJA DE MARCAS — prueba social real ===== -->
    <section class="bg-white border-b border-zaga-line">
      <div class="max-w-7xl mx-auto px-6 py-14">
        <div class="flex flex-wrap items-baseline justify-between gap-4 mb-8 animate-on-scroll">
          <p class="ind-eyebrow">{t('home.brands.eyebrow')}</p>
          <a
            href={`${basePath}/marcas/`}
            class="ind-data text-xs uppercase tracking-[0.12em] text-zaga-blue hover:text-zaga-navy transition-colors inline-flex items-center gap-2"
          >
            {t('home.brands.link')}
            <span class="ind-figure text-zaga-amber">{totalMarcas}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="ind-logo-strip animate-on-scroll">
          {logosDestacados.map((m) => (
            <div class="ind-logo-cell">
              <Image src={m.img} alt={`${m.name} logo`} loading="eager" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== CÓMO TRABAJAMOS — lista numerada, no 3 cards iguales ===== -->
    <section class="py-20 lg:py-28 px-6 bg-zaga-surface">
      <div class="max-w-7xl mx-auto">
        <p class="ind-eyebrow mb-10 animate-on-scroll">{t('home.features.eyebrow')}</p>

        <div class="ind-specs grid-cols-1 md:grid-cols-3">
          {features.map((f, i) => (
            <div
              class="ind-spec bg-white flex flex-col gap-4 p-8 lg:p-10 animate-on-scroll"
              style={`transition-delay: ${i * 90}ms`}
            >
              <div class="flex items-center justify-between">
                <div class="w-12 h-12 icon-chip flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={f.icon} />
                  </svg>
                </div>
                <span class="ind-figure text-3xl text-zaga-line">{f.num}</span>
              </div>

              <h3 class="card-title ind-display text-2xl">
                {t(`feature.${f.key}.title` as any)}
              </h3>
              <p class="text-zaga-ink-muted leading-relaxed">
                {t(`feature.${f.key}.desc` as any)}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== CONOCE ZAGA ===== -->
    <section class="py-20 lg:py-28 px-6 bg-white relative overflow-hidden">
      <div class="ind-grid-lines ind-grid-lines-dark" aria-hidden="true"></div>

      <div class="relative z-10 max-w-5xl mx-auto animate-on-scroll">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          <div class="lg:col-span-4">
            <p class="ind-eyebrow mb-4">{t('nav.about')}</p>
            <h2 class="display-title ind-display text-4xl lg:text-5xl text-zaga-navy">
              {t('home.about.title')}
            </h2>
          </div>

          <div class="lg:col-span-8 border-l-0 lg:border-l lg:border-zaga-line lg:pl-10">
            <p class="text-lg md:text-xl text-zaga-ink-muted leading-relaxed mb-8">
              {t('home.about.desc')}
            </p>
            <a href={`${basePath}/nosotros/`} class="ind-btn ind-btn-solid">
              {t('home.about.btn')}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
