---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { marcas, categorias } from '../../data/marcas';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/marcas/*.{png,jpg,jpeg,svg,webp}', { eager: true });

const normalizeBrandName = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, '');

const getBrandLogo = (brandName: string): ImageMetadata | null => {
  const normalizedMatch = normalizeBrandName(brandName);
  for (const path in logos) {
    const filename = path.split('/').pop()?.split('.')[0] || '';
    if (normalizeBrandName(filename) === normalizedMatch) {
      return logos[path].default;
    }
  }
  return null;
};

const roboCobreImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/robo-cobre.{jpg,jpeg,png,webp}', { eager: true });
const roboCobreImage = (Object.values(roboCobreImages)[0] as { default: ImageMetadata } | undefined)?.default ?? null;

// Catálogo de categorías de Soldexel
const soldexelCategorias = [
  { titulo: "Áreas Peligrosas Clasificadas",    url: "https://soldexel.com/categoria-producto/areas-peligrosas-clasificadas/",       imgKey: "areas_peligrosas"  },
  { titulo: "Luminarias para Áreas Clasificadas", url: "https://soldexel.com/categoria-producto/iluminacion-areas-clasificadas/",    imgKey: "luminarias"        },
  { titulo: "Áreas de Alto Desempeño",           url: "https://soldexel.com/categoria-producto/areas-de-alto-desempeno-intemperie/", imgKey: "alto_desempeno"    },
  { titulo: "Accesorios de Conexión",            url: "https://soldexel.com/categoria-producto/accesorios-de-conexion/",             imgKey: "accesorios"        },
  { titulo: "Sistemas de Puesta a Tierra",       url: "https://soldexel.com/categoria-producto/sistemas-de-puesta-a-tierra/",        imgKey: "puesta_tierra"     },
  { titulo: "Protección Contra Rayos",           url: "https://soldexel.com/categoria-producto/apantallamiento/",                   imgKey: "proteccion_rayos"  },
];

const categoriasImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/categorias/*.{png,jpg,jpeg,webp}', { eager: true });

const imgKeyToFile: Record<string, string> = {
  areas_peligrosas:  'AreasPeligrosasClasificadas',
  luminarias:        'LuminariasparaAreasClasificadas',
  alto_desempeno:    'AreasdeAltoDesempeno',
  accesorios:        'AccesoriosDeConexion',
  puesta_tierra:     'SistemasDePuestasATierra',
  proteccion_rayos:  'ProteccionContraRayos',
};

const getCategoriaImage = (imgKey: string): ImageMetadata | null => {
  const filename = imgKeyToFile[imgKey];
  if (!filename) return null;
  for (const path in categoriasImages) {
    if (path.includes(filename)) return categoriasImages[path].default;
  }
  return null;
};

/*
 * Clientes de Spartan. Antes los nombres (Bancos / Hoteles / Constructoras)
 * estaban escritos a mano en el HTML, así que la versión en inglés seguía
 * mostrándolos en español. Ahora salen de ui.ts como todo lo demás.
 */
const spartanClientes = [
  {
    titleKey: 'brands.spartan.client.bancos.title',
    descKey: 'brands.spartan.client.bancos',
    icon: 'M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z',
  },
  {
    titleKey: 'brands.spartan.client.hoteles.title',
    descKey: 'brands.spartan.client.hoteles',
    icon: 'M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z',
  },
  {
    titleKey: 'brands.spartan.client.constructoras.title',
    descKey: 'brands.spartan.client.constructoras',
    icon: 'M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25',
  },
] as const;

const soldexelLogo   = getBrandLogo('soldexel');
const philcoLogo     = getBrandLogo('PHILCO-SLP-BRILLA-MAX');
const dimasLogo      = getBrandLogo('Dimas Lighting');
const copperclladLogo = getBrandLogo('copperclad');
const alumocladLogo  = getBrandLogo('alumoclad');
const conduccasaLogo = getBrandLogo('CONDUCCASA');
const spartanLogo    = getBrandLogo('logo_spartansmartbox');
---

<Layout lang={lang} title={t('seo.brands.title')} description={t('seo.brands.desc')}>
  <div class="flex-grow flex flex-col">

    <!-- Hero Header -->
    <section class="bg-zaga-navy pt-28 pb-20 lg:pt-32 lg:pb-24 px-6 relative overflow-hidden">
      <div class="absolute inset-0 z-0 opacity-[0.03]" style="background-image: radial-gradient(#ffffff 2px, transparent 2px); background-size: 30px 30px;"></div>
      <div class="relative z-10 max-w-5xl mx-auto animate-on-scroll">
        <h1 class="display-title rule-accent text-4xl lg:text-6xl font-bold text-white tracking-tight">
          {t('brands.title')}
        </h1>
        <p class="text-lg lg:text-xl text-blue-50/90 mt-7 max-w-2xl leading-relaxed">
          {t('brands.subtitle')}
        </p>
      </div>
    </section>

    <!-- Introducción -->
    <section class="section-tight px-6 bg-zaga-surface border-b border-zaga-line">
      <div class="max-w-4xl mx-auto animate-on-scroll">
        <p class="text-xl lg:text-2xl text-zaga-navy leading-relaxed mb-5 font-semibold">
          {t('brands.intro.p1')}
        </p>
        <p class="text-lg text-zaga-ink-muted leading-relaxed mb-7">
          {t('brands.intro.p2')}
        </p>
        <p class="text-sm font-bold text-zaga-blue uppercase tracking-[0.14em]">
          {t('brands.intro.p3')}
        </p>
      </div>
    </section>

    <!-- ===== DISTRIBUCIONES OFICIALES ===== -->
    <section class="section px-6 bg-white relative">
      <div class="max-w-7xl mx-auto">

        <div class="mb-12 animate-on-scroll">
          <span class="inline-block bg-zaga-cyan/10 text-zaga-blue text-[11px] font-semibold px-4 py-2 rounded-full mb-5 uppercase tracking-[0.14em] border border-zaga-cyan/25">
            {t('brands.dist.badge')}
          </span>
          <h2 class="display-title rule-accent text-3xl lg:text-4xl font-bold text-zaga-navy">{t('brands.dist.title')}</h2>
          <p class="mt-7 text-lg text-zaga-ink-muted max-w-2xl">{t('brands.dist.subtitle')}</p>
        </div>

        <!-- Soldexel — Tarjeta Principal -->
        <div class="card overflow-hidden mb-6 animate-on-scroll relative">
          <span class="absolute inset-x-0 top-0 h-1 bg-zaga-blue z-10" aria-hidden="true"></span>
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-0">

            <!-- Panel de Logo -->
            <div class="lg:col-span-2 bg-zaga-surface flex items-center justify-center p-10 border-b lg:border-b-0 lg:border-r border-zaga-line">
              <a href="https://soldexel.com/" target="_blank" rel="noopener noreferrer" class="block w-full max-w-[300px] mx-auto group">
                {soldexelLogo ? (
                  <Image src={soldexelLogo} alt="Soldexel Logo" class="w-full h-auto object-contain transition-transform duration-300 group-hover:scale-105" />
                ) : (
                  <div class="flex items-center justify-center bg-white rounded-card p-8 border border-zaga-line text-2xl font-bold text-zaga-navy tracking-widest group-hover:border-zaga-blue transition-colors">
                    SOLDEXEL
                  </div>
                )}
              </a>
            </div>

            <!-- Panel de Contenido -->
            <div class="lg:col-span-3 p-8 lg:p-10 flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-bold text-zaga-navy mb-3">Soldexel</h3>
                <p class="text-zaga-ink-muted text-lg leading-relaxed mb-8">{t('brands.soldexel.desc')}</p>

                <!-- Catálogo de Categorías Soldexel — Cuadrícula Circular -->
                <div class="grid grid-cols-3 gap-x-4 gap-y-6 mt-2">
                  {soldexelCategorias.map((cat) => {
                    const img = getCategoriaImage(cat.imgKey);
                    return (
                      <a
                        href={cat.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex flex-col items-center gap-2 text-center"
                      >
                        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border-[3px] border-zaga-line group-hover:border-zaga-blue group-hover:scale-105 transition-all duration-300 flex-shrink-0">
                          {img ? (
                            <Image src={img} alt={cat.titulo} class="w-full h-full object-cover" />
                          ) : (
                            <div class="w-full h-full icon-chip flex items-center justify-center">
                              <span class="text-[9px] font-bold text-center px-1 leading-tight">{cat.titulo}</span>
                            </div>
                          )}
                        </div>
                        <span class="text-[11px] font-semibold text-zaga-ink-muted group-hover:text-zaga-blue transition-colors leading-tight">{cat.titulo}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Philco + Dimas Lighting -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <!-- Philco Iluminación -->
          <div class="card card-hover-raise p-8 lg:p-9 animate-on-scroll flex flex-col relative overflow-hidden">
            <span class="absolute inset-x-0 top-0 h-1 bg-zaga-cyan" aria-hidden="true"></span>
            <div class="aspect-video bg-zaga-surface rounded-ui flex items-center justify-center p-6 mb-6 border border-zaga-line">
              {philcoLogo ? (
                <Image src={philcoLogo} alt="PHILCO Iluminación Logo" class="w-full h-full object-contain" />
              ) : (
                <span class="font-bold text-2xl text-zaga-ink-faint tracking-widest">PHILCO</span>
              )}
            </div>
            <h3 class="text-xl font-bold text-zaga-navy mb-2">PHILCO Iluminación</h3>
            <p class="text-zaga-ink-muted leading-relaxed">{t('brands.philco.desc')}</p>
          </div>

          <!-- Dimas Lighting -->
          <div class="card card-hover-raise p-8 lg:p-9 animate-on-scroll flex flex-col relative overflow-hidden" style="transition-delay: 100ms;">
            <span class="absolute inset-x-0 top-0 h-1 bg-zaga-cyan" aria-hidden="true"></span>
            <div class="aspect-video bg-zaga-surface rounded-ui flex items-center justify-center p-6 mb-6 border border-zaga-line">
              {dimasLogo ? (
                <Image src={dimasLogo} alt="Dimas Lighting Logo" class="w-full h-full object-contain" />
              ) : (
                <span class="font-bold text-2xl text-zaga-ink-faint tracking-widest">DIMAS LIGHTING</span>
              )}
            </div>
            <h3 class="text-xl font-bold text-zaga-navy mb-2">Dimas Lighting</h3>
            <p class="text-zaga-ink-muted leading-relaxed">{t('brands.dimas.desc')}</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ===== REPRESENTACIONES OFICIALES ===== -->
    <section class="section px-6 bg-zaga-surface relative">
      <div class="max-w-7xl mx-auto">

        <div class="mb-12 animate-on-scroll">
          <span class="inline-block bg-zaga-navy/10 text-zaga-navy text-[11px] font-semibold px-4 py-2 rounded-full mb-5 uppercase tracking-[0.14em] border border-zaga-navy/20">
            {t('brands.rep.badge')}
          </span>
          <h2 class="display-title rule-accent text-3xl lg:text-4xl font-bold text-zaga-navy">{t('brands.rep.title')}</h2>
          <p class="mt-7 text-lg text-zaga-ink-muted max-w-2xl">{t('brands.rep.subtitle')}</p>
        </div>

        <!-- ---- Fábrica 1: Cable Antirrobo ---- -->
        <div class="card overflow-hidden mb-6 animate-on-scroll">

          <!-- Header de Fábrica -->
          <div class="bg-zaga-navy px-8 py-5 flex items-center gap-5">
            <div class="w-10 h-10 bg-zaga-blue rounded-full flex items-center justify-center flex-shrink-0 font-bold text-white text-lg">1</div>
            <div>
              <span class="text-white/50 text-xs uppercase tracking-widest">{t('brands.factory.label')}</span>
              <h3 class="text-white text-xl font-bold">{t('brands.cableantirobo.section')}</h3>
            </div>
          </div>

          <div class="p-8 lg:p-10">

            <!--
              Concepto CCS. El rojo de alerta se cambia por la paleta de la
              casa: este bloque destaca el argumento de venta, no avisa de un
              error, y en los presets fiusha el rojo chocaba de frente.
            -->
            <div class="bg-zaga-surface border-l-4 border-zaga-blue rounded-ui p-6 mb-9">
              <p class="font-bold text-zaga-navy text-lg mb-2">{t('brands.cableantirobo.concept')}</p>
              <p class="text-zaga-ink-muted leading-relaxed">{t('brands.cableantirobo.desc')}</p>
            </div>

            <!-- Imagen + Info Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-9">

              <!-- Imagen: Robo de Cobre -->
              <div class="rounded-card overflow-hidden bg-zaga-navy aspect-video flex items-center justify-center">
                {roboCobreImage ? (
                  <Image src={roboCobreImage} alt={t('brands.copper.theft.label')} class="w-full h-full object-cover" />
                ) : (
                  <div class="text-center p-8">
                    <div class="w-16 h-16 text-white/40 mx-auto mb-4">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>
                    </div>
                    <p class="text-white/70 text-sm font-medium">{t('brands.copper.theft.label')}</p>
                    <p class="text-white/40 text-xs mt-1">{t('brands.copper.theft.placeholder')}</p>
                  </div>
                )}
              </div>

              <!-- Información CCS + Enlace -->
              <div class="flex flex-col justify-center gap-6">
                <div>
                  <h4 class="text-xl font-bold text-zaga-navy mb-3">{t('brands.copper.theft.label')}</h4>
                  <p class="text-zaga-ink-muted leading-relaxed">{t('brands.cableantirobo.copper.info')}</p>
                </div>
                <a
                  href="https://cableantirobo.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="self-start inline-flex items-center gap-2 bg-zaga-navy text-white px-6 py-3 rounded-ui font-semibold hover:bg-zaga-blue transition-colors duration-200"
                >
                  cableantirobo.com
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>
            </div>

            <!-- 3 Marcas: Copperclad, Alumoclad, Conduccasa -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

              <!-- Copperclad -->
              <div class="card card-hover-raise overflow-hidden flex flex-col">
                <a href="https://copperclad.com.mx/" target="_blank" rel="noopener noreferrer" class="block bg-zaga-surface p-6 flex items-center justify-center aspect-video border-b border-zaga-line hover:bg-white transition-colors">
                  {copperclladLogo ? (
                    <Image src={copperclladLogo} alt="Copperclad Logo" class="w-full h-full object-contain" />
                  ) : (
                    <span class="font-bold text-lg text-zaga-ink-faint tracking-wider text-center">COPPERCLAD</span>
                  )}
                </a>
                <div class="p-5 flex flex-col flex-1 gap-4">
                  <div>
                    <h4 class="font-bold text-zaga-navy mb-1">Copperclad</h4>
                    <p class="text-sm text-zaga-ink-muted leading-relaxed">{t('brands.copperclad.desc')}</p>
                  </div>
                  <div class="mt-auto">
                    <a href="/pdfs/copperclad.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-zaga-surface hover:bg-white text-zaga-blue border border-zaga-line hover:border-zaga-blue px-3 py-2 rounded-ui text-sm font-semibold transition-colors duration-200">
                      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                      {t('brands.pdf.view')}
                    </a>
                  </div>
                </div>
              </div>

              <!-- Alumoclad -->
              <div class="card card-hover-raise overflow-hidden flex flex-col">
                <a href="https://alumoclad.com.mx/" target="_blank" rel="noopener noreferrer" class="block bg-zaga-surface p-6 flex items-center justify-center aspect-video border-b border-zaga-line hover:bg-white transition-colors">
                  {alumocladLogo ? (
                    <Image src={alumocladLogo} alt="Alumoclad Logo" class="w-full h-full object-contain" />
                  ) : (
                    <span class="font-bold text-lg text-zaga-ink-faint tracking-wider text-center">ALUMOCLAD</span>
                  )}
                </a>
                <div class="p-5 flex flex-col flex-1 gap-4">
                  <div>
                    <h4 class="font-bold text-zaga-navy mb-1">Alumoclad</h4>
                    <p class="text-sm text-zaga-ink-muted leading-relaxed">{t('brands.alumoclad.desc')}</p>
                  </div>
                  <div class="mt-auto">
                    <a href="/pdfs/alumoclad.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-zaga-surface hover:bg-white text-zaga-blue border border-zaga-line hover:border-zaga-blue px-3 py-2 rounded-ui text-sm font-semibold transition-colors duration-200">
                      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                      {t('brands.pdf.view')}
                    </a>
                  </div>
                </div>
              </div>

              <!-- Conduccasa -->
              <div class="card card-hover-raise overflow-hidden flex flex-col">
                <a href="https://conduccasa.com/" target="_blank" rel="noopener noreferrer" class="block bg-zaga-surface p-6 flex items-center justify-center aspect-video border-b border-zaga-line hover:bg-white transition-colors">
                  {conduccasaLogo ? (
                    <Image src={conduccasaLogo} alt="Conduccasa Logo" class="w-full h-full object-contain" />
                  ) : (
                    <span class="font-bold text-lg text-zaga-ink-faint tracking-wider text-center">CONDUCCASA</span>
                  )}
                </a>
                <div class="p-5 flex flex-col flex-1 gap-4">
                  <div>
                    <h4 class="font-bold text-zaga-navy mb-1">Conduccasa</h4>
                    <p class="text-sm text-zaga-ink-muted leading-relaxed">{t('brands.conduccasa.ccs.desc')}</p>
                  </div>
                  <div class="mt-auto">
                    <a href="/pdfs/conduccasa.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-zaga-surface hover:bg-white text-zaga-blue border border-zaga-line hover:border-zaga-blue px-3 py-2 rounded-ui text-sm font-semibold transition-colors duration-200">
                      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                      {t('brands.pdf.view')}
                    </a>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- ---- Fábrica 2: Spartan Smart Box ---- -->
        <div class="card overflow-hidden animate-on-scroll">

          <!-- Header de Fábrica -->
          <div class="bg-zaga-navy px-8 py-5 flex items-center gap-5">
            <div class="w-10 h-10 bg-zaga-cyan rounded-full flex items-center justify-center flex-shrink-0 font-bold text-zaga-navy text-lg">2</div>
            <div>
              <span class="text-white/50 text-xs uppercase tracking-widest">{t('brands.factory.label')}</span>
              <h3 class="text-white text-xl font-bold">{t('brands.spartan.title')}</h3>
            </div>
          </div>

          <div class="p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-5 gap-9 items-start">

            <!-- Logo -->
            <div class="lg:col-span-2 flex items-center justify-center">
              <div class="bg-zaga-surface rounded-card p-10 border border-zaga-line w-full max-w-sm flex items-center justify-center aspect-video">
                {spartanLogo ? (
                  <Image src={spartanLogo} alt="Spartan Smart Box Logo" class="w-full h-full object-contain" />
                ) : (
                  <span class="font-bold text-xl text-zaga-ink-faint tracking-wider text-center leading-relaxed">SPARTAN<br/>SMART BOX</span>
                )}
              </div>
            </div>

            <!-- Contenido -->
            <div class="lg:col-span-3 flex flex-col gap-6">

              <!-- Slogan -->
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 text-zaga-blue flex-shrink-0">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.516 2.17a.75.75 0 00-1.032 0 11.209 11.209 0 01-7.877 3.08.75.75 0 00-.722.515A12.74 12.74 0 002.25 9.75c0 5.942 4.064 10.933 9.563 12.348a.749.749 0 00.374 0c5.499-1.415 9.563-6.406 9.563-12.348 0-1.39-.223-2.73-.635-3.985a.75.75 0 00-.722-.516l-.143.001c-2.996 0-5.717-1.17-7.734-3.08z" clip-rule="evenodd"/></svg>
                </div>
                <div>
                  <span class="text-xs font-semibold text-zaga-ink-faint uppercase tracking-widest block mb-0.5">{t('brands.spartan.specialists')}</span>
                  <h4 class="text-xl font-bold text-zaga-navy leading-tight">{t('brands.spartan.slogan')}</h4>
                </div>
              </div>

              <!-- Descripción principal -->
              <p class="text-zaga-ink-muted leading-relaxed">{t('brands.spartan.main.desc')}</p>

              <!-- Clientes principales -->
              <div>
                <p class="text-xs font-semibold text-zaga-ink-faint uppercase tracking-widest mb-3">{t('brands.spartan.clients.intro')}</p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  {spartanClientes.map((cliente) => (
                    <div class="bg-zaga-surface border border-zaga-line rounded-ui p-4 flex flex-col gap-2">
                      <div class="w-7 h-7 text-zaga-blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d={cliente.icon} />
                        </svg>
                      </div>
                      <h5 class="font-bold text-zaga-navy text-sm">{t(cliente.titleKey as any)}</h5>
                      <p class="text-xs text-zaga-ink-muted leading-relaxed">{t(cliente.descKey as any)}</p>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Cobertura Nacional -->
              <div class="flex items-center gap-3 bg-zaga-navy/5 border border-zaga-navy/10 rounded-ui px-5 py-3">
                <div class="w-5 h-5 text-zaga-cyan flex-shrink-0">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                </div>
                <p class="text-sm font-semibold text-zaga-navy">{t('brands.spartan.coverage')}</p>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ===== CATÁLOGO GENERAL DE MARCAS ===== -->
    <section class="section px-6 bg-white relative">
      <div class="max-w-7xl mx-auto">

        <div class="mb-10 animate-on-scroll">
          <h2 class="display-title rule-accent text-3xl lg:text-4xl font-bold text-zaga-navy">
            {t('brands.catalog')}
          </h2>
          <p class="mt-7 text-lg text-zaga-ink-muted max-w-2xl">{t('brands.catalog.intro')}</p>
        </div>

        <!-- Filtros por categoría (sticky al hacer scroll) -->
        <div
          id="marcas-filtros"
          class="sticky top-16 z-30 -mx-6 px-6 py-4 mb-10 bg-white/90 backdrop-blur-md border-b border-zaga-line"
        >
          <div class="marca-filtros-scroll" role="group" aria-label={t('brands.filter.label')}>
            <button
              type="button"
              class="marca-filtro is-active"
              data-filtro="all"
              aria-pressed="true"
            >
              {t('brands.filter.all')}
              <span class="marca-filtro-count">{marcas.length}</span>
            </button>
            {categorias.map((cat) => {
              const count = marcas.filter((m) => m.categoria === cat.id).length;
              return (
                <button type="button" class="marca-filtro" data-filtro={cat.id} aria-pressed="false">
                  <svg class="marca-filtro-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {t(cat.titleKey as any)}
                  <span class="marca-filtro-count">{count}</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Descripción de la categoría activa (solo con una sola seleccionada) -->
        <div id="marcas-cat-desc" class="marca-cat-desc-wrap is-empty max-w-3xl mx-auto text-center">
          {categorias.map((cat) => (
            <p class="marca-cat-desc text-zaga-ink-muted leading-relaxed hidden" data-desc={cat.id}>
              {t(cat.descKey as any)}
            </p>
          ))}
        </div>

        <!-- Grilla de marcas -->
        <div id="marcas-grid" class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {marcas.map((marca) => {
            const logo = getBrandLogo(marca.name);
            const Tag = marca.url ? 'a' : 'div';
            const linkAttrs = marca.url
              ? { href: marca.url, target: '_blank', rel: 'noopener noreferrer' }
              : {};
            return (
              <Tag {...linkAttrs} class="marca-card group" data-categoria={marca.categoria}>
                <div class="marca-card-logo">
                  {logo ? (
                    <Image src={logo} alt={`${marca.name} Logo`} class="marca-card-logo-img" />
                  ) : (
                    <span class="font-bold text-zaga-ink-faint tracking-wider text-lg">{marca.name}</span>
                  )}
                </div>

                <h3 class="text-lg font-bold text-zaga-navy uppercase tracking-tight mb-2">
                  {marca.name}
                </h3>

                <p class="text-sm text-zaga-ink-muted leading-relaxed mb-4 flex-grow">
                  {marca.desc}
                </p>

                <div class="flex flex-wrap gap-1.5 mb-4">
                  {marca.tags.map((tag) => (
                    <span class="marca-tag">{tag}</span>
                  ))}
                </div>

                {marca.url && (
                  <span class="mt-auto inline-flex items-center gap-1.5 text-xs font-semibold text-zaga-blue uppercase tracking-wider group-hover:gap-2.5 transition-all duration-300">
                    {t('brands.visit.site')}
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </span>
                )}
              </Tag>
            );
          })}
        </div>

      </div>
    </section>

    <!-- Mensaje Final -->
    <section class="section-tight px-6 bg-zaga-navy relative overflow-hidden">
      <div class="absolute inset-0 z-0 opacity-[0.03]" style="background-image: radial-gradient(#ffffff 2px, transparent 2px); background-size: 30px 30px;"></div>
      <div class="relative z-10 max-w-4xl mx-auto animate-on-scroll">
        <p class="text-2xl lg:text-3xl font-bold text-white mb-5 leading-snug">
          {t('brands.outro.p1')}
        </p>
        <p class="text-lg lg:text-xl text-blue-50/80 leading-relaxed">
          {t('brands.outro.p2')}
        </p>
      </div>
    </section>

  </div>
</Layout>

<style>
  /*
   * ── Contenedor de filtros ──
   * En escritorio los 9 filtros caben centrados en dos renglones. En móvil,
   * apilados ocuparían casi toda la pantalla (y al ser sticky taparían el
   * contenido), así que ahí se convierten en una tira con scroll horizontal.
   */
  .marca-filtros-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    flex-wrap: nowrap;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* Sangrado para que el primer y último chip no queden pegados al borde */
    margin: 0 -1.5rem;
    padding: 0 1.5rem;
  }
  .marca-filtros-scroll::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 768px) {
    .marca-filtros-scroll {
      flex-wrap: wrap;
      justify-content: center;
      overflow-x: visible;
      margin: 0;
      padding: 0;
    }
  }

  /* ── Píldoras de filtro ──
     rounded-full es correcto aquí: son píldoras, el caso que el sistema sí
     reserva para el radio completo. */
  .marca-filtro {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--zaga-line);
    background: white;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--zaga-ink-muted);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .marca-filtro:hover {
    border-color: var(--zaga-blue);
    color: var(--zaga-navy);
  }
  .marca-filtro.is-active {
    background: var(--zaga-navy);
    border-color: var(--zaga-navy);
    color: white;
  }
  .marca-filtro:focus-visible {
    outline: 2px solid var(--zaga-cyan);
    outline-offset: 2px;
  }
  .marca-filtro-count {
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.0625rem 0.375rem;
    border-radius: 9999px;
    background: var(--zaga-surface);
    color: var(--zaga-ink-faint);
  }
  .marca-filtro.is-active .marca-filtro-count {
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }
  /*
   * La palomita indica que el filtro es de selección múltiple. Ocupa su
   * espacio solo cuando la categoría está activa, así el chip crece en vez
   * de reservar un hueco vacío permanente.
   */
  .marca-filtro-check {
    width: 0;
    height: 0.875rem;
    opacity: 0;
    overflow: hidden;
    transition: width 0.2s ease, opacity 0.2s ease, margin-right 0.2s ease;
  }
  .marca-filtro.is-active .marca-filtro-check {
    width: 0.875rem;
    opacity: 1;
  }

  /*
   * Contenedor de la descripción de categoría. Solo separa de la grilla
   * cuando hay algo que mostrar (una única categoría activa); si está vacío
   * se colapsa para no dejar un hueco entre los filtros y las tarjetas.
   */
  .marca-cat-desc-wrap {
    margin-bottom: 2.5rem;
  }
  .marca-cat-desc-wrap.is-empty {
    margin-bottom: 0;
  }

  /*
   * ── Tarjeta de marca ──
   * Antes esta grilla tenía su propio lenguaje (radio 1rem, sombra propia)
   * y arriba convivían tarjetas rounded-3xl con sombras grandes: dos
   * dialectos en la misma página. Ahora toma el radio, el borde y la sombra
   * del sistema, igual que .card.
   */
  .marca-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-card);
    background: white;
    border: 1px solid var(--zaga-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: box-shadow 0.3s, transform 0.3s, border-color 0.3s;
  }
  /* Acento superior que crece desde la izquierda al hacer hover */
  .marca-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--zaga-navy), var(--zaga-cyan));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  a.marca-card:hover,
  a.marca-card:focus-visible {
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--zaga-blue) 28%, white);
  }
  a.marca-card:focus-visible {
    outline: 2px solid var(--zaga-cyan);
    outline-offset: 2px;
  }
  a.marca-card:focus-visible::before {
    transform: scaleX(1);
  }
  a.marca-card:hover::before {
    transform: scaleX(1);
  }
  .marca-card-logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 4.5rem;
    margin-bottom: 1.25rem;
  }
  /*
   * Los archivos de logo vienen en proporciones muy distintas: algunos son
   * apaisados (1200x880) y otros son fotos verticales (768x1024). Limitar
   * solo la altura dejaba los verticales diminutos, así que se acota la caja
   * en ambos ejes y `object-fit: contain` decide qué lado manda.
   */
  .marca-card-logo :global(.marca-card-logo-img) {
    max-height: 4.5rem;
    max-width: 11rem;
    width: auto;
    height: auto;
    object-fit: contain;
    object-position: left center;
    transition: transform 0.3s;
  }
  a.marca-card:hover .marca-card-logo :global(.marca-card-logo-img) {
    transform: scale(1.04);
  }

  /* ── Etiquetas de producto ──
     Son píldoras, así que llevan radio completo en vez del 0.25rem suelto
     que era el séptimo radio distinto de la página. */
  .marca-tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--zaga-ink-muted);
    background: var(--zaga-surface);
    border: 1px solid var(--zaga-line);
    border-radius: 9999px;
    padding: 0.25rem 0.625rem;
  }

  /* ── Estado oculto al filtrar ── */
  .marca-card.is-hidden {
    display: none;
  }

  /*
   * Copia superpuesta de una tarjeta que se está yendo. El original se retira
   * del flujo al instante —para que las demás empiecen a moverse enseguida— y
   * este clon se queda desvaneciéndose sobre su posición anterior.
   */
  .marca-card.is-ghost {
    pointer-events: none;
    margin: 0;
    z-index: 1;
  }

  /* Sin animación de reacomodo si el usuario la desactivó en su sistema */
  @media (prefers-reduced-motion: reduce) {
    .marca-card {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Filtrado de marcas con selección múltiple y animación FLIP.
   *
   * FLIP = First, Last, Invert, Play: se mide la posición de cada tarjeta antes
   * y después de filtrar y se anima la diferencia, de modo que las tarjetas
   * viajan visiblemente hasta su nuevo lugar en vez de saltar.
   *
   * Se pueden activar varias categorías a la vez; sin ninguna activa se
   * muestran todas (así el usuario nunca acaba ante una página vacía).
   */
  function initFiltroMarcas() {
    const grid = document.getElementById('marcas-grid');
    const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('.marca-filtro'));
    if (!grid || botones.length === 0) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.marca-card'));
    const descripciones = Array.from(document.querySelectorAll<HTMLElement>('.marca-cat-desc'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const MOVER = 620;   // viaje de las tarjetas que se reacomodan
    const SALIR = 260;   // desvanecido de las que se van
    const ENTRAR = 480;  // aparición de las que llegan
    const PASO = 26;     // retraso incremental entre tarjetas (efecto cascada)
    const SUAVIZADO = 'cubic-bezier(0.22, 1, 0.36, 1)';

    // Categorías activas. Vacío = mostrar todas.
    const seleccion = new Set<string>();
    let enCurso: Animation[] = [];

    const visible = (card: HTMLElement) =>
      seleccion.size === 0 || seleccion.has(card.dataset.categoria || '');

    function aplicarFiltro() {
      for (const anim of enCurso) anim.cancel();
      enCurso = [];
      for (const card of cards) card.classList.remove('is-leaving');

      if (reduceMotion) {
        for (const card of cards) card.classList.toggle('is-hidden', !visible(card));
        actualizarTextos();
        return;
      }

      // FIRST: posiciones antes de tocar nada.
      const posiciones = new Map<HTMLElement, DOMRect>();
      for (const card of cards) {
        if (!card.classList.contains('is-hidden')) {
          posiciones.set(card, card.getBoundingClientRect());
        }
      }

      // Fijar la altura actual del contenedor para poder animarla después.
      const altoPrevio = grid.getBoundingClientRect().height;

      const entrantes: HTMLElement[] = [];
      const salientes: HTMLElement[] = [];
      const permanecen: HTMLElement[] = [];
      for (const card of cards) {
        const estaVisible = !card.classList.contains('is-hidden');
        const deberia = visible(card);
        if (deberia && !estaVisible) entrantes.push(card);
        else if (!deberia && estaVisible) salientes.push(card);
        else if (deberia && estaVisible) permanecen.push(card);
      }

      // Las salientes dejan el flujo de inmediato: así el resto puede ocupar su
      // lugar y el movimiento se aprecia. Se siguen viendo mientras se apagan,
      // superpuestas en su posición original.
      for (const card of salientes) {
        const caja = posiciones.get(card);
        card.classList.add('is-hidden');
        if (!caja) continue;
        const contenedor = grid.getBoundingClientRect();
        const fantasma = card.cloneNode(true) as HTMLElement;
        fantasma.classList.remove('is-hidden');
        fantasma.classList.add('is-ghost');
        fantasma.style.position = 'absolute';
        fantasma.style.top = `${caja.top - contenedor.top}px`;
        fantasma.style.left = `${caja.left - contenedor.left}px`;
        fantasma.style.width = `${caja.width}px`;
        fantasma.style.height = `${caja.height}px`;
        grid.appendChild(fantasma);
        const anim = fantasma.animate(
          [
            { opacity: 1, transform: 'scale(1)' },
            { opacity: 0, transform: 'scale(0.92)' },
          ],
          { duration: SALIR, easing: 'ease-out', fill: 'forwards' }
        );
        enCurso.push(anim);
        anim.finished.then(() => fantasma.remove()).catch(() => fantasma.remove());
      }

      // Revelar las entrantes para medir su posición final.
      for (const card of entrantes) card.classList.remove('is-hidden');

      // LAST + INVERT + PLAY.
      // Un salto de varias pantallas animado como desplazamiento se ve como un
      // borrón cruzando la página, así que por encima de este umbral la tarjeta
      // aparece en su sitio en lugar de viajar.
      const VIAJE_MAXIMO = window.innerHeight * 1.1;
      const movimientos: { card: HTMLElement; dx: number; dy: number }[] = [];
      for (const card of permanecen) {
        const antes = posiciones.get(card);
        if (!antes) continue;
        const ahora = card.getBoundingClientRect();
        const dx = antes.left - ahora.left;
        const dy = antes.top - ahora.top;
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1) continue;
        if (Math.hypot(dx, dy) > VIAJE_MAXIMO) {
          entrantes.push(card);
          continue;
        }
        movimientos.push({ card, dx, dy });
      }

      // El retraso crece con la distancia recorrida: las tarjetas que menos se
      // mueven arrancan antes y el conjunto fluye en cascada.
      movimientos.sort((a, b) => Math.hypot(a.dx, a.dy) - Math.hypot(b.dx, b.dy));
      movimientos.forEach(({ card, dx, dy }, i) => {
        enCurso.push(
          card.animate(
            [
              { transform: `translate(${dx}px, ${dy}px)` },
              { transform: 'translate(0, 0)' },
            ],
            {
              duration: MOVER,
              easing: SUAVIZADO,
              delay: Math.min(i * (PASO / 3), 160),
            }
          )
        );
      });

      // Animar la altura del contenedor para que el pie de página no dé un salto.
      const altoNuevo = grid.getBoundingClientRect().height;
      if (Math.abs(altoNuevo - altoPrevio) > 1) {
        enCurso.push(
          grid.animate(
            [{ height: `${altoPrevio}px` }, { height: `${altoNuevo}px` }],
            { duration: MOVER, easing: SUAVIZADO }
          )
        );
      }

      // Las entrantes aparecen escalonadas, después de que el hueco se abrió.
      entrantes.forEach((card, i) => {
        enCurso.push(
          card.animate(
            [
              { opacity: 0, transform: 'translateY(14px) scale(0.96)' },
              { opacity: 1, transform: 'translateY(0) scale(1)' },
            ],
            {
              duration: ENTRAR,
              easing: SUAVIZADO,
              delay: SALIR * 0.6 + Math.min(i * PASO, 320),
              fill: 'backwards',
            }
          )
        );
      });

      actualizarTextos();
    }

    function actualizarTextos() {
      // Con una sola categoría activa se muestra su descripción; con varias no,
      // porque apilar párrafos empujaría la grilla y estorbaría la lectura.
      const unica = seleccion.size === 1 ? [...seleccion][0] : null;
      for (const desc of descripciones) {
        desc.classList.toggle('hidden', desc.dataset.desc !== unica);
      }
      // Colapsar el contenedor cuando no hay descripción visible.
      document
        .getElementById('marcas-cat-desc')
        ?.classList.toggle('is-empty', unica === null);

      for (const boton of botones) {
        const filtro = boton.dataset.filtro || '';
        const activo =
          filtro === 'all' ? seleccion.size === 0 : seleccion.has(filtro);
        boton.classList.toggle('is-active', activo);
        boton.setAttribute('aria-pressed', String(activo));
      }
    }

    for (const boton of botones) {
      const filtro = boton.dataset.filtro || '';
      // "Todas" limpia la selección; las demás alternan.
      boton.setAttribute('aria-pressed', String(filtro === 'all'));
      boton.addEventListener('click', () => {
        if (filtro === 'all') seleccion.clear();
        else if (seleccion.has(filtro)) seleccion.delete(filtro);
        else seleccion.add(filtro);
        aplicarFiltro();
      });
    }

    // Permite enlazar a una o varias categorías: /marcas#control,iluminacion
    const desdeHash = window.location.hash.slice(1);
    if (desdeHash) {
      const validas = new Set(botones.map((b) => b.dataset.filtro));
      for (const parte of desdeHash.split(',')) {
        const id = decodeURIComponent(parte.trim());
        if (id && id !== 'all' && validas.has(id)) seleccion.add(id);
      }
      if (seleccion.size > 0) aplicarFiltro();
    }
  }

  initFiltroMarcas();
  // Astro View Transitions: re-inicializar tras cada navegación.
  document.addEventListener('astro:after-swap', initFiltroMarcas);
</script>
