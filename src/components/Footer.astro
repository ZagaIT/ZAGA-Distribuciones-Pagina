---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

// Utilizando i18n para los enlaces del footer
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = lang === 'en' ? '/en' : '';
---

<footer class="bg-zaga-navy text-white py-8 mt-auto">
  <div class="container mx-auto px-4 text-center justify-center flex flex-col md:flex-row items-center md:justify-between">
    <p class="ind-data text-xs text-white/55">
      &copy; {new Date().getFullYear()} ZAGA Distribuciones. {t('footer.rights')}
    </p>
    <div class="ind-data flex space-x-6 mt-4 md:mt-0 text-xs uppercase tracking-[0.12em]">
      <a href={`${basePath}/`} class="hover:text-zaga-amber transition-colors">{t('nav.home')}</a>
      <a href={`${basePath}/contacto/`} class="hover:text-zaga-amber transition-colors">{t('nav.contact')}</a>
    </div>
  </div>
</footer>
